# ==============================================================================
# LearnMate AI - Danh mục Biến Môi trường Mẫu (.env.example)
# Đối chiếu chuẩn 100% theo Tài liệu Thiết kế Hệ thống SDD (Bảng 23)
# Hướng dẫn: Sao chép tệp này thành .env và điền các giá trị thực tế của bạn:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cơ sở dữ liệu MySQL 8.0 (Container: learnmate_mysql)
# ------------------------------------------------------------------------------
DB_HOST=mysql
MYSQL_HOST_PORT=3306
DB_ROOT_PASSWORD=SecretRoot2026!
DB_NAME=learnmate
DB_USER=learnmate_user
DB_PASSWORD=learnmate_pass

# ------------------------------------------------------------------------------
# 2. Backend Core Service (Container: learnmate_backend)
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
DATABASE_URL=mysql+pymysql://learnmate_user:learnmate_pass@mysql:3306/learnmate?charset=utf8mb4

# Khóa bí mật ký số JWT (tối thiểu 32 ký tự, HMAC-SHA256)
JWT_SECRET=YourSuperSecretKeyMin32Chars2026!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Danh sách domain được phép gọi API (CORS), ngăn cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost:3000

# Khóa bí mật nội bộ xác thực giữa Backend Core và AI Microservice (X-API-Key)
INTERNAL_API_KEY=LM_Internal_Key_987654

# ------------------------------------------------------------------------------
# 3. AI Microservice (Container: learnmate_ai)
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT_SECONDS=60

# Hạn mức QuotaGuard (BR-05): số câu hỏi tối đa / sinh viên / ngày (reset 00:00 UTC)
TUTOR_DAILY_QUOTA=50

# Cấu hình nhà cung cấp LLM: "gemini" hoặc "openai"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# Khóa API chính thức của các nhà cung cấp AI
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 4. Frontend SPA (Container: learnmate_frontend)
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080/api/v1
