# ==============================================================================
# LearnMate AI - Environment Variables Configuration Template (.env.example)
# Copy this file to .env and adjust variables accordingly for local execution.
# ==============================================================================

# Database Configuration (MySQL 8.0)
DB_HOST=127.0.0
MYSQL_HOST_PORT=3306
DB_ROOT_PASSWORD=your_root_password
DB_NAME=learnmate
DB_USER=learnmate_user
DB_PASSWORD=your_secure_password

# Backend Core Service Configuration
BACKEND_PORT=8080
JWT_SECRET=your_jwt_secret_key_minimum_32_chars_length
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Danh sách origins cho CORS, ngăn cách bằng dấu phẩy (không có khoảng trắng dư thừa)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Internal Service Communication Security
INTERNAL_API_KEY=your_internal_api_key_for_microservice_calls

# AI Microservice Configuration
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://ai-service:8000
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Service Configuration
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080/api/v1
